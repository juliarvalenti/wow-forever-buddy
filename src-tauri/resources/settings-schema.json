{
  "version": 1,
  "options": [
    {
      "id": "window.briefing",
      "module": "window",
      "section": "In game",
      "type": "bool",
      "default": true,
      "label": "Login briefing",
      "help": "One quiet chat line when you log in: quests to hand in, repairs, mail on your alts, your note.",
      "acts": false
    },
    {
      "id": "window.lockouts",
      "module": "window",
      "section": "In game",
      "type": "bool",
      "default": true,
      "label": "Lockouts at the entrance",
      "help": "When you enter a dungeon or raid, says which of your other characters are saved there.",
      "acts": false
    },
    {
      "id": "window.coach",
      "module": "window",
      "section": "In game",
      "type": "bool",
      "default": false,
      "label": "Session coach",
      "help": "A small strip with this session's gold, experience and loot.",
      "acts": false
    },
    {
      "id": "window.coachCombat",
      "module": "window",
      "section": "In game",
      "type": "bool",
      "default": false,
      "label": "Hide the coach in combat",
      "help": "Steps out of the way while you fight.",
      "parent": "window.coach",
      "acts": false
    },
    {
      "id": "window.card",
      "module": "window",
      "section": "In game",
      "type": "bool",
      "default": true,
      "label": "Session card at logout",
      "help": "A short summary of the session during the logout countdown.",
      "acts": false
    },
    {
      "id": "window.bagMarks",
      "module": "window",
      "section": "In game",
      "type": "bool",
      "default": true,
      "label": "Marks in your bags",
      "help": "Coin and letter marks on items you marked to sell or send in Forever Buddy.",
      "acts": false
    },
    {
      "id": "tooltips.alts",
      "module": "tooltips",
      "section": "Tooltips",
      "type": "bool",
      "default": true,
      "label": "Your alts on item tooltips",
      "help": "Which of your other characters hold an item, and where.",
      "acts": false
    },
    {
      "id": "map.coords",
      "module": "map",
      "section": "Map",
      "type": "bool",
      "default": false,
      "label": "Coordinates on the world map",
      "help": "Where you are, and where the cursor points, along the bottom of the world map.",
      "acts": false
    },
    {
      "id": "map.minimap",
      "module": "map",
      "section": "Map",
      "type": "bool",
      "default": false,
      "label": "Coordinates under the minimap",
      "help": "Where you are, in small numbers under the minimap.",
      "acts": false
    },
    {
      "id": "map.fade",
      "module": "map",
      "section": "Map",
      "type": "bool",
      "default": false,
      "label": "Fade the world map while you move",
      "help": "The map turns see-through while you walk or ride, so you can see where you're going.",
      "acts": false
    },
    {
      "id": "map.fadeAlpha",
      "module": "map",
      "section": "Map",
      "type": "number",
      "default": 0.5,
      "label": "How much of the map shows while moving",
      "help": "Lower is more see-through.",
      "parent": "map.fade",
      "acts": false,
      "min": 0.1,
      "max": 0.9,
      "step": 0.05
    },
    {
      "id": "quest.levels",
      "module": "quest",
      "section": "Quests",
      "type": "bool",
      "default": false,
      "label": "Quest levels in the quest log",
      "help": "Each quest's level before its title, like [23] Wanted: Hogger.",
      "acts": false
    },
    {
      "id": "quest.newTag",
      "module": "quest",
      "section": "Quests",
      "type": "bool",
      "default": false,
      "label": "Mark quests that are new in Forever",
      "help": "A (New) tag after the quests WoW Forever added, so you can tell them from the original game's.",
      "acts": false
    },
    {
      "id": "quest.tooltips",
      "module": "quest",
      "section": "Quests",
      "type": "bool",
      "default": false,
      "label": "Quest progress on item tooltips",
      "help": "When a quest in your log needs an item, its tooltip says which quest and how many you have.",
      "acts": false
    },
    {
      "id": "quest.trackerFade",
      "module": "quest",
      "section": "Quests",
      "type": "bool",
      "default": false,
      "label": "See-through quest tracker",
      "help": "The quest tracker fades until you move the mouse over it.",
      "acts": false
    },
    {
      "id": "quest.trackerAlpha",
      "module": "quest",
      "section": "Quests",
      "type": "number",
      "default": 0.4,
      "label": "How much of the tracker shows",
      "help": "Lower is more see-through. It's whole while the mouse is over it.",
      "parent": "quest.trackerFade",
      "acts": false,
      "min": 0.1,
      "max": 0.9,
      "step": 0.05
    },
    {
      "id": "window.minimap",
      "module": "window",
      "section": "This window",
      "type": "bool",
      "default": true,
      "label": "Minimap button",
      "help": "Click to open Forever Buddy. Drag to move.",
      "acts": false
    },
    {
      "id": "window.record",
      "module": "window",
      "section": "Help fix bugs",
      "type": "bool",
      "default": false,
      "label": "Record my next session",
      "help": "Numbers only: no names, chat or mail. Turns itself off when you log out.",
      "acts": false,
      "showHelp": true
    }
  ],
  "lints": [
    {
      "id": "map.fadeNearlyGone",
      "when": {
        "map.fade": true,
        "map.fadeAlpha": {
          "max": 0.2
        }
      },
      "say": "The world map almost disappears while you move."
    },
    {
      "id": "quest.trackerNearlyGone",
      "when": {
        "quest.trackerAlpha": {
          "max": 0.15
        },
        "quest.trackerFade": true
      },
      "say": "The quest tracker almost disappears until you move the mouse over it."
    }
  ],
  "presets": [
    {
      "id": "quiet",
      "label": "Quiet",
      "values": {
        "map.coords": false,
        "map.fade": false,
        "map.minimap": false,
        "quest.levels": false,
        "quest.newTag": false,
        "quest.tooltips": false,
        "quest.trackerFade": false,
        "tooltips.alts": true,
        "window.bagMarks": false,
        "window.briefing": true,
        "window.card": false,
        "window.coach": false,
        "window.coachCombat": false,
        "window.lockouts": false,
        "window.minimap": false
      }
    },
    {
      "id": "helpful",
      "label": "Helpful",
      "values": {
        "map.coords": true,
        "map.fade": false,
        "map.minimap": false,
        "quest.levels": true,
        "quest.newTag": true,
        "quest.tooltips": true,
        "quest.trackerFade": false,
        "tooltips.alts": true,
        "window.bagMarks": true,
        "window.briefing": true,
        "window.card": true,
        "window.coach": false,
        "window.coachCombat": false,
        "window.lockouts": true,
        "window.minimap": true
      }
    },
    {
      "id": "everything",
      "label": "Everything",
      "values": {
        "map.coords": true,
        "map.fade": true,
        "map.fadeAlpha": 0.5,
        "map.minimap": true,
        "quest.levels": true,
        "quest.newTag": true,
        "quest.tooltips": true,
        "quest.trackerAlpha": 0.5,
        "quest.trackerFade": true,
        "tooltips.alts": true,
        "window.bagMarks": true,
        "window.briefing": true,
        "window.card": true,
        "window.coach": true,
        "window.coachCombat": true,
        "window.lockouts": true,
        "window.minimap": true
      }
    }
  ]
}
