<Bindings>
	<!-- Key Bindings > AddOns > ForeverBuddy Lite. Each press is one search (see Groups.lua). -->
	<Binding name="FBL_GROUPS_REFRESH" header="FBL">FBL_GroupsRefresh()</Binding>
	<Binding name="FBL_GROUPS_TOGGLE">FBL_GroupsToggle()</Binding>
	<Binding name="FBL_TARGET_TOGGLE">FBL_TargetToggle()</Binding>
	<!-- Clicks the target box button (Target.lua): a secure click, so it can target. -->
	<Binding name="CLICK FBLTargetButton:Keybind"></Binding>
</Bindings>
