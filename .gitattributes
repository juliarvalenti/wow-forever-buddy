# Test fixtures are compared byte-for-byte (backup/restore round-trips), so git
# must never rewrite their line endings on Windows checkouts.
src-tauri/tests/fixtures/** -text

# Generated by tauri-specta; keep LF everywhere so the CI drift check is stable.
src/lib/bindings.ts text eol=lf

# WOWAPI, vendored for the in-game window pictures (tools/wowapi/ORIGIN.md):
# collapsed in PR diffs and left out of the repo's language stats.
tools/wowapi/** linguist-vendored

# The ForeverBuddy addon: the app bundles these bytes and the release zips
# them, so a Windows build ships the same files as any other (not CRLF).
src-tauri/resources/addon/** text eol=lf
# Its art and fonts are bytes, never text: no line-ending rewrite at all.
src-tauri/resources/addon/**/*.tga binary
src-tauri/resources/addon/**/*.ttf binary

# The harness's layout snapshots are compared byte-for-byte with what it
# writes (LF), and H5 runs the harness on Windows too.
tools/addon-test/snapshots/** text eol=lf

# Generated by the harness from the addon's settings (P4a), compared the same way.
src-tauri/resources/settings-schema.json text eol=lf
